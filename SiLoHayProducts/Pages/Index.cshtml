@page
@model SiLoHayProductsNew.Pages.IndexModel
@{
}
@inject IConfiguration configuration
@{
    var siteKey = configuration["ReCaptchaSettings:SiteKey"];
}

<link rel="stylesheet" href="~/css/Products.css" />
<link rel="stylesheet" href="~/css/IndexBanner.css" />
<script src="~/js/IndexBanner.js"></script>

<style>
    .grecaptcha-badge {
        visibility: hidden;
    }
</style>



